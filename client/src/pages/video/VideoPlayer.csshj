/* components/Video/VideoPlayerModern.css */

.video-player-modern {
  background: #0f0f0f;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

/* Video Container */
.video-container {
  position: relative;
  background: #000;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.video-element {
  width: 100%;
  height: 100%;
  object-fit: contain;
  cursor: pointer;
}

/* Loading State */
.video-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  z-index: 10;
  color: white;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Center Play Button */
.center-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 20;
}

.center-play-btn:hover {
  background: rgba(244, 63, 94, 0.8);
  transform: translate(-50%, -50%) scale(1.1);
}

/* Controls Overlay */
.video-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  padding: 20px;
  z-index: 30;
}

.controls-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.video-title h3 {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 600;
  color: white;
}

.video-meta {
  display: flex;
  gap: 16px;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}

.controls-top-right {
  display: flex;
  gap: 12px;
}

.control-btn {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(4px);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: white;
  transition: all 0.2s ease;
}

.control-btn:hover {
  background: rgba(244, 63, 94, 0.8);
  transform: scale(1.05);
}

/* Progress Bar */
.progress-bar-container {
  margin-bottom: 12px;
  cursor: pointer;
}

.progress-bar-bg {
  position: relative;
  height: 4px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2px;
  overflow: visible;
  transition: height 0.2s ease;
}

.progress-bar-container:hover .progress-bar-bg {
  height: 6px;
}

.progress-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: #f43f5e;
  border-radius: 2px;
  transition: width 0.1s linear;
}

.progress-bar-buffer {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 2px;
}

.progress-bar-handle {
  position: absolute;
  top: 50%;
  width: 12px;
  height: 12px;
  background: #f43f5e;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.progress-bar-container:hover .progress-bar-handle {
  opacity: 1;
}

/* Bottom Controls Row */
.controls-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.controls-left,
.controls-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Volume Control */
.volume-control {
  display: flex;
  align-items: center;
  gap: 8px;
}

.volume-slider {
  width: 80px;
  height: 4px;
  -webkit-appearance: none;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2px;
  outline: none;
}

.volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  background: #f43f5e;
  border-radius: 50%;
  cursor: pointer;
}

/* Time Display */
.time-display {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: white;
  font-family: monospace;
}

/* Menu Dropdowns */
.menu-container {
  position: relative;
}

.menu-dropdown {
  position: absolute;
  bottom: 100%;
  right: 0;
  margin-bottom: 8px;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 8px;
  padding: 4px;
  min-width: 80px;
  z-index: 40;
}

.menu-dropdown button {
  display: block;
  width: 100%;
  padding: 8px 12px;
  background: transparent;
  border: none;
  color: white;
  text-align: left;
  font-size: 13px;
  cursor: pointer;
  border-radius: 4px;
  transition: background 0.2s ease;
}

.menu-dropdown button:hover {
  background: rgba(244, 63, 94, 0.3);
}

.quality-text {
  font-size: 12px;
  font-weight: 500;
}

/* Video Info Section */
.video-info-section {
  padding: 20px;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
}

.info-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.title-section {
  flex: 1;
}

.title-section h2 {
  margin: 0 0 12px;
  font-size: 22px;
  font-weight: 700;
  color: white;
}

.description {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
}

.actions-section {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  cursor: pointer;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.2s ease;
}

.action-btn span {
  font-size: 13px;
  font-weight: 500;
}

.action-btn:hover {
  color: #f43f5e;
}

.action-btn.like-btn.active {
  color: #f43f5e;
}

.action-btn.like-btn.active svg {
  fill: #f43f5e;
  stroke: #f43f5e;
  animation: likePop 0.3s ease;
}

@keyframes likePop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

.stats-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
}

.stats-badge.engagement {
  background: rgba(34, 197, 94, 0.2);
  color: #22c55e;
}

/* Tags Section */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.tag {
  padding: 4px 12px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: all 0.2s ease;
}

.tag:hover {
  background: rgba(244, 63, 94, 0.3);
  color: white;
}

/* Like Animation */
.like-animation {
  position: fixed;
  font-size: 32px;
  pointer-events: none;
  z-index: 1000;
  animation: floatUp 1s ease-out forwards;
}

@keyframes floatUp {
  0% {
    opacity: 1;
    transform: translateY(0) scale(0.5);
  }
  50% {
    transform: translateY(-100px) scale(1.2);
  }
  100% {
    opacity: 0;
    transform: translateY(-200px) scale(0.8);
  }
}

/* Toast */
.custom-toast {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(10px);
  color: white;
  padding: 10px 20px;
  border-radius: 40px;
  font-size: 14px;
  z-index: 2000;
  animation: toastSlide 0.3s ease, toastFade 0.3s ease 2.7s forwards;
}

@keyframes toastSlide {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

@keyframes toastFade {
  to {
    opacity: 0;
    transform: translateX(-50%) translateY(-20px);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .video-info-section {
    padding: 16px;
  }
  
  .title-section h2 {
    font-size: 18px;
  }
  
  .description {
    font-size: 13px;
  }
  
  .actions-section {
    gap: 16px;
  }
  
  .action-btn svg {
    width: 20px;
    height: 20px;
  }
  
  .stats-badge {
    padding: 4px 8px;
    font-size: 11px;
  }
  
  .control-btn {
    width: 32px;
    height: 32px;
  }
  
  .volume-slider {
    width: 60px;
  }
  
  .video-meta {
    flex-wrap: wrap;
    gap: 8px;
  }
}

/* Fullscreen */
.video-player-modern:fullscreen {
  border-radius: 0;
  background: black;
}

.video-player-modern:fullscreen .video-container {
  height: 100vh;
}

.video-player-modern:fullscreen .video-info-section {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
}

/* Tooltip */
.video-tooltip {
  position: fixed;
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  pointer-events: none;
  z-index: 1000;
  white-space: nowrap;
}

