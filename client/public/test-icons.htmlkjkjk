        let currentFilter = 'all';
        let searchTerm = '';

        async function checkIconExists(iconName) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = () => resolve(true);
                img.onerror = () => resolve(false);
                img.src = '/icons/' + iconName + '?t=' + Date.now();
            });
        }

        function filterIcons(filter) {
            currentFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            renderIcons();
        }

        function updateStatusSummary(stats) {
            const summary = document.getElementById('statusSummary');
            const success = stats.filter(s => s.exists).length;
            const warning = stats.filter(s => !s.exists).length;
            summary.innerHTML = `
                <strong>📊 Resumen de estado:</strong> 
                <span style="color: #155724; background: #d4edda; padding: 3px 8px; border-radius: 3px;">✅ ${success} iconos existentes</span>
                <span style="color: #856404; background: #fff3cd; padding: 3px 8px; border-radius: 3px; margin-left: 10px;">⚠️ ${warning} placeholders (reemplazar)</span>
            `;
        }

        async function renderIcons() {
            const grid = document.getElementById('iconsGrid');
            const searchInput = document.getElementById('searchInput');
            searchTerm = searchInput.value.toLowerCase();
            
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center;">Cargando iconos...</div>';
            
            // Verificar cada icono
            const iconStatus = await Promise.all(
                iconList.map(async icon => ({
                    ...icon,
                    exists: await checkIconExists(icon.name)
                }))
            );

            // Actualizar estadísticas
            const totalIcons = iconStatus.length;
            const level1Count = iconStatus.filter(i => i.level === 1).length;
            const level2Count = iconStatus.filter(i => i.level === 2).length;
            const level3Count = iconStatus.filter(i => i.level === 3).length;
            
            document.getElementById('totalIcons').textContent = totalIcons;
            document.getElementById('level1Count').textContent = level1Count;
            document.getElementById('level2Count').textContent = level2Count;
            document.getElementById('level3Count').textContent = level3Count;
            
            updateStatusSummary(iconStatus);

            // Filtrar
            const filtered = iconStatus.filter(icon => {
                // Filtro por nivel
                if (currentFilter === 'level1' && icon.level !== 1) return false;
                if (currentFilter === 'level2' && icon.level !== 2) return false;
                if (currentFilter === 'level3' && icon.level !== 3) return false;
                if (currentFilter === 'success' && !icon.exists) return false;
                if (currentFilter === 'warning' && icon.exists) return false;
                
                // Búsqueda por nombre
                if (searchTerm && !icon.name.toLowerCase().includes(searchTerm)) return false;
                
                return true;
            });

            // Renderizar
            if (filtered.length === 0) {
                grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 50px;">No se encontraron iconos</div>';
                return;
            }

            grid.innerHTML = filtered.map(icon => {
                const levelText = icon.level === 1 ? 'Principal' : icon.level === 2 ? 'Subcategoría' : 'Artículo';
                const statusClass = icon.exists ? 'status-success' : 'status-warning';
                const statusText = icon.exists ? '✅ Icono real' : '⚠️ Placeholder';
                const iconDisplay = icon.exists ? 
                    `<img src="/icons/${icon.name}" alt="${icon.name}" onerror="this.onerror=null; this.parentElement.innerHTML='🖼️';">` : 
                    '📁';
                
                return `
                    <div class="icon-card" data-level="${icon.level}">
                        <div class="icon-preview">${iconDisplay}</div>
                        <div class="icon-name">${icon.name.replace('.png', '')}</div>
                        <div class="icon-level">Nivel ${icon.level} - ${levelText}</div>
                        <div class="icon-path">/icons/${icon.name}</div>
                        <div class="icon-status ${statusClass}">${statusText}</div>
                    </div>
                `;
            }).join('');
        }

        // Búsqueda en tiempo real
        document.getElementById('searchInput').addEventListener('input', () => {
            renderIcons();
        });

        // Cargar al inicio
        renderIcons();
    </script>
</body>
</html>