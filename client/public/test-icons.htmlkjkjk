<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test de Iconos - Categorías Marketplace</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 20px;
            background-color: #f8f9fa;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 3px solid #3498db;
            padding-bottom: 10px;
        }
        .stats-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin: 20px 0;
        }
        .stat-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .stat-value {
            font-size: 36px;
            font-weight: bold;
            color: #3498db;
        }
        .stat-label {
            font-size: 14px;
            color: #7f8c8d;
            margin-top: 5px;
        }
        .filter-container {
            margin: 20px 0;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .filter-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            background: #ecf0f1;
            color: #2c3e50;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
        }
        .filter-btn:hover {
            background: #bdc3c7;
        }
        .filter-btn.active {
            background: #3498db;
            color: white;
        }
        .icons-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .icon-card {
            background: white;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }
        .icon-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .icon-preview {
            width: 64px;
            height: 64px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            border-radius: 50%;
            font-size: 32px;
        }
        .icon-preview img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }
        .icon-name {
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 5px;
            word-break: break-word;
            font-size: 14px;
        }
        .icon-level {
            font-size: 12px;
            color: #7f8c8d;
            margin-bottom: 5px;
        }
        .icon-path {
            font-size: 10px;
            color: #95a5a6;
            word-break: break-all;
            margin-bottom: 5px;
        }
        .icon-status {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 3px;
            display: inline-block;
        }
        .status-success {
            background: #d4edda;
            color: #155724;
        }
        .status-warning {
            background: #fff3cd;
            color: #856404;
        }
        .search-box {
            width: 100%;
            padding: 10px;
            margin: 20px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
        }
        .summary {
            background: white;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <h1>📱 Test de Iconos - Categorías Marketplace</h1>
    <p>Ruta base: <strong>/icons/</strong> (coincide con el seed)</p>
    
    <div class="stats-container" id="stats">
        <div class="stat-card">
            <div class="stat-value" id="totalIcons">0</div>
            <div class="stat-label">Total Iconos</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="level1Count">0</div>
            <div class="stat-label">Nivel 1</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="level2Count">0</div>
            <div class="stat-label">Nivel 2</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="level3Count">0</div>
            <div class="stat-label">Nivel 3</div>
        </div>
    </div>

    <div class="summary" id="statusSummary">
        <strong>📊 Resumen de estado:</strong> Cargando...
    </div>

    <input type="text" class="search-box" id="searchInput" placeholder="🔍 Buscar icono...">

    <div class="filter-container">
        <button class="filter-btn active" onclick="filterIcons('all')">Todos</button>
        <button class="filter-btn" onclick="filterIcons('level1')">Nivel 1</button>
        <button class="filter-btn" onclick="filterIcons('level2')">Nivel 2</button>
        <button class="filter-btn" onclick="filterIcons('level3')">Nivel 3</button>
        <button class="filter-btn" onclick="filterIcons('success')">Solo existentes</button>
        <button class="filter-btn" onclick="filterIcons('warning')">Solo placeholders</button>
    </div>

    <div class="icons-grid" id="iconsGrid"></div>

